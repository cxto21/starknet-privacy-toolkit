FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
  git curl unzip ca-certificates build-essential \
  python3 python3-venv python3-dev python3-pip \
  libc++1 pkg-config && rm -rf /var/lib/apt/lists/*

# Non-root user for safety
RUN useradd -ms /bin/bash runner
USER runner
WORKDIR /home/runner/app

# Copy repo into container
COPY . .

# Prepare and run dependency setup (deps-only)
RUN chmod +x scripts/*.sh || true && ./scripts/setup.sh

# Verify installers and versions
RUN make install-all

# Build Cairo verifier
RUN cd donation_badge_verifier && scarb build

# Noir compile + tests for donation badge
RUN cd zk-badges/donation_badge && nargo compile && nargo test
